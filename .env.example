# Scranton - environment template.
# Copy this file to .env and fill in your keys. Never commit .env (it is git-ignored).

# LLM provider selection: mistral | gemini
# Provider-agnostic by design - see PRODUCT_ROADMAP.md section 2.
LLM_PROVIDER=mistral

# Mistral API key - https://console.mistral.ai (used when LLM_PROVIDER=mistral)
MISTRAL_API_KEY=

# Gemini API key - fallback if Mistral quality is insufficient (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
