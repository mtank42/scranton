# Scranton - environment template.
# Copy this file to .env and fill in your keys. Never commit .env (it is git-ignored).

# LLM provider selection: mistral | gemini
# Provider-agnostic by design - see PRODUCT_ROADMAP.md section 2.
LLM_PROVIDER=mistral

# Mistral API key - https://console.mistral.ai (used when LLM_PROVIDER=mistral)
MISTRAL_API_KEY=

# Gemini API key - fallback if Mistral quality is insufficient (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Optional - data locations. Defaults: data/scranton.db and data/chroma under the repo.
# Data location is configuration, never code: point these at a NAS mount or another volume if needed.
# DATABASE_URL=sqlite:////absolute/path/to/scranton.db
# CHROMA_DIR=/absolute/path/to/chroma

# Google Drive ingestion (optional - see docs/google_drive_ingestion.md).
# The folder id is the last part of the Drive folder URL.
# GDRIVE_FOLDER_ID=
# GOOGLE_CLIENT_SECRETS=data/google_client_secrets.json
# GOOGLE_TOKEN_FILE=data/google_token.json
